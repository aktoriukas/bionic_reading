{
  "manifest_version": 3,
  "name": "Bionic Reading",
  "version": "1.1.0",
  "description": "Make your reading experience more comfortable",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "16": "icon16.png"
  },
  "background": {
    "service_worker": "src/bg.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "src/popup.html"
  },
  "commands": {
    "toggle-bionic-reading": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Toggle Bionic Reading on the current page"
    }
  }
}
